<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Lingualearn</title>

    <link rel="stylesheet" href="style.css">
</head>

<body>

    <header>
        <h1>🌍 Lingualearn</h1>
        <p>128 Dilli Çeviri ve Kelime Öğrenme Uygulaması</p>
    </header>

    <main class="container">

        <section class="card">

            <div class="language-row">

                <div class="language-box">
                    <label for="sourceLanguage">Kaynak Dil</label>

                    <select id="sourceLanguage">
                        <option>Türkçe</option>
                        <option>İngilizce</option>
                        <option>Almanca</option>
                        <option>Fransızca</option>
                        <option>Kürtçe</option>
                    </select>
                </div>

                <div class="swap">
                    ⇄
                </div>

                <div class="language-box">
                    <label for="targetLanguage">Hedef Dil</label>

                    <select id="targetLanguage">
                        <option>İngilizce</option>
                        <option>Türkçe</option>
                        <option>Almanca</option>
                        <option>Fransızca</option>
                        <option>Kürtçe</option>
                    </select>
                </div>

            </div>

            <br>

            <label for="textInput">Çevrilecek kelime veya cümle</label>

            <textarea
                id="textInput"
                placeholder="Örneğin: beautiful"></textarea>

            <button class="translate-button">
                🌐 Çevir
            </button>

        </section>


        <section class="card result">

            <h3>🔤 Çeviri</h3>

            <p id="translation">
                Çeviri sonucu burada görünecek.
            </p>

        </section>


        <section class="card">

            <div class="info-grid">

                <div class="info-box">

                    <h3>📖 Anlam</h3>

                    <p id="meaning">
                        Kelimenin anlamı burada gösterilecek.
                    </p>

                </div>


                <div class="info-box">

                    <h3>📊 Kullanım Seviyesi</h3>

                    <p id="level">
                        A1 - A2 - B1 - B2 - C1 - C2
                    </p>

                </div>


                <div class="info-box">

                    <h3>💬 Örnek Cümle</h3>

                    <p id="example">
                        Örnek cümle burada gösterilecek.
                    </p>

                </div>


                <div class="info-box">

                    <h3>🔄 Alternatif Kelimeler</h3>

                    <p id="alternatives">
                        Alternatif kelimeler burada gösterilecek.
                    </p>

                </div>

            </div>

        </section>

    </main>


  <footer>
    © 2026 Lingualearn
</footer>

</body>
</html>