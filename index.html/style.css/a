* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    background: #f4f7fb;
    color: #172033;
    min-height: 100vh;
}

header {
    background: linear-gradient(135deg, #243b80, #4d6fd8);
    color: white;
    padding: 35px 20px;
    text-align: center;
}

header h1 {
    font-size: 42px;
    margin-bottom: 10px;
}

header p {
    font-size: 18px;
}

.container {
    width: 90%;
    max-width: 1000px;
    margin: 30px auto;
}

.card {
    background: white;
    border-radius: 18px;
    padding: 25px;
    margin-bottom: 20px;
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
}

.language-row {
    display: flex;
    gap: 15px;
    align-items: center;
}

.language-box {
    flex: 1;
}

label {
    display: block;
    font-weight: bold;
    margin-bottom: 8px;
}

select,
textarea {
    width: 100%;
    padding: 14px;
    border: 1px solid #d5dbea;
    border-radius: 12px;
    font-size: 16px;
    background: white;
}

textarea {
    min-height: 150px;
    resize: vertical;
}

.swap {
    font-size: 25px;
    padding-top: 25px;
}

.translate-button {
    width: 100%;
    margin-top: 18px;
    padding: 15px;
    border: none;
    border-radius: 12px;
    background: #3f5fd5;
    color: white;
    font-size: 18px;
    font-weight: bold;
    cursor: pointer;
}

.translate-button:hover {
    background: #304db8;
}

.result {
    border-left: 5px solid #3f5fd5;
}

.result h3 {
    margin-bottom: 10px;
}

.info-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
}

.info-box {
    background: #f5f7ff;
    padding: 18px;
    border-radius: 12px;
}

footer {
    text-align: center;
    padding: 25px;
    color: #667085;
}

@media (max-width: 700px) {
    .language-row {
        flex-direction: column;
    }

    .swap {
        padding-top: 0;
    }

    .info-grid {
        grid-template-columns: 1fr;
    }

    header h1 {
        font-size: 32px;
    }
}